{
  "name": "dota2-coach-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing Dota 2 match analysis (via OpenDota) as a tool, for use in Claude Desktop (stdio) or as a remote connector in claude.ai (Streamable HTTP)",
  "private": true,
  "license": "MIT",
  "author": "gilangwinduasmara",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "start:http": "node server.js --http",
    "build": "esbuild server.js --bundle --platform=node --target=node18 --external:express --outfile=dist/server.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
